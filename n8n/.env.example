# Configuration locale uniquement : ne pas versionner le fichier .env.
N8N_VERSION=2.36.7
N8N_PORT=5678
RFM_API_PORT=8000

# Obligatoire : générer un mot de passe personnel avant le premier démarrage.
POSTGRES_PASSWORD=

# Interface web, accessible sur http://127.0.0.1:3001
FRONTEND_PORT=3001
# Jeton du credential Header Auth X-RFM-Token de n8n, pas la clé DeepSeek.
# Peut rester vide pour explorer les données sans utiliser le chatbot.
N8N_WEBHOOK_TOKEN=
# Obligatoire et stable : générer avec openssl rand -hex 32.
SESSION_SECRET=
